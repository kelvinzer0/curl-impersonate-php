{
    "name": "kelvinzer0/curl-impersonate-php",
    "description": "PHP wrapper for curl-impersonate — mimic real browser TLS fingerprints to bypass anti-bot detection",
    "type": "library",
    "keywords": [
        "curl",
        "curl-impersonate",
        "http-client",
        "browser-fingerprint",
        "tls-fingerprint",
        "anti-bot",
        "web-scraping",
        "chrome",
        "firefox",
        "safari"
    ],
    "homepage": "https://github.com/kelvinzer0/curl-impersonate-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Kelvin Yuli Andrian",
            "homepage": "https://github.com/kelvinzer0",
            "role": "Maintainer"
        }
    ],
    "autoload": {
        "psr-4": {
            "CurlImpersonate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CurlImpersonate\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.0"
    },
    "support": {
        "issues": "https://github.com/kelvinzer0/curl-impersonate-php/issues",
        "source": "https://github.com/kelvinzer0/curl-impersonate-php"
    },
    "config": {
        "sort-packages": true
    }
}
